{
  "name": "meshdrop",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/desktop --noEmit",
    "desktop:build": "pnpm --filter @meshdrop/desktop build",
    "desktop:e2e": "pnpm --filter @meshdrop/desktop build && pnpm --filter @meshdrop/desktop e2e",
    "desktop:dev": "pnpm --filter @meshdrop/desktop build && pnpm --filter @meshdrop/desktop exec electron ."
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
