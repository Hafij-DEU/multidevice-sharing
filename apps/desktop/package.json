{
  "name": "@meshdrop/desktop",
  "productName": "MeshDrop",
  "version": "0.9.8",
  "description": "MeshDrop desktop app: send files between your devices",
  "author": "Hafij-BGE <mdhafijur.rahman@ogr.deu.edu.tr>",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Hafij-DEU/meshdrop",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "desktopName": "meshdrop.desktop",
  "scripts": {
    "build": "vite build -c vite.main.config.ts && vite build -c vite.renderer.config.ts && vite build -c vite.cli.config.ts && node scripts/copy-icons.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p . --noEmit",
    "dist": "bash scripts/build-deb.sh",
    "dist:linux": "bash scripts/build-linux.sh",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win.ps1"
  },
  "devDependencies": {
    "@meshdrop/core": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "42.1.0",
    "electron-builder": "26.15.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  }
}
