{
  "name": "@meshdrop/desktop",
  "productName": "MeshDrop",
  "version": "0.1.0",
  "private": true,
  "description": "MeshDrop: send files between your own devices, at home or away",
  "author": "Md Hafijur Rahman <mdhafijur.rahman@ogr.deu.edu.tr>",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "vite build -c vite.main.config.ts && vite build -c vite.renderer.config.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p . --noEmit",
    "dist": "electron-builder --linux deb"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@meshdrop/core": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "42.1.0",
    "electron-builder": "26.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  }
}
