<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- targetSdk 35 forces edge-to-edge; the WebView applies window insets itself (WebUi). -->
    <style name="Theme.MeshDrop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="Theme.MeshDrop.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
