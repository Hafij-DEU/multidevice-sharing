<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The chooser draws the app's own colours (PickerActivity.palette()); values-night has the dark ones. -->
    <style name="Theme.MeshDropPicker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/meshdrop_picker_bg</item>
        <item name="android:statusBarColor">@color/meshdrop_picker_bg</item>
        <item name="android:navigationBarColor">@color/meshdrop_picker_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <color name="meshdrop_picker_bg">#f7f5ff</color>
</resources>
