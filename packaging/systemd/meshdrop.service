[Unit]
Description=MeshDrop device (hub on the hub PC): receiver, hub link and relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# /usr/bin/meshdrop comes with the .deb; from a source checkout use %h/.local/bin/meshdrop (docs/protocol.md).
ExecStart=/usr/bin/meshdrop listen --device-type headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
